# ── 1. Operview DAPI (Incidências, Clientes, CHI, Duração) ──
OPERVIEW_API_URL=https://operview-ce.enel.com

# ── 2. Spotfire Web Player (M300 Deslocamentos) ──
SPOTFIRE_REPORT_URL=
SPOTFIRE_URL=https://spotfire-ce.enel.com/spotfire/wp/
SPOTFIRE_USERNAME=
SPOTFIRE_PASSWORD=
SPOTFIRE_POLOS=ATLANTICO,DNORT

# ── 3. EquipesBrasilCE API (Filial, Turnos, Login, Ordens) ──
EQUIPES_BRASILCE_API=

# ── 4. Diferenciação de Equipes Próprias vs Parceiras ──
PROPRIA_FILIAL_KEYWORDS=ENEL
PARCEIRAS_FILIAL_KEYWORDS=BeQ,Applus

# ── 5. Ciclo de Varredura (em minutos) ──
CYCLE_MINUTES=3

# ── 6. WhatsApp Automation ──
WHATSAPP_DEFAULT_GROUP=Alertas Operacionais COI
WHATSAPP_AUTO_SEND=true
WHATSAPP_HEADLESS=true
WHATSAPP_USER_DATA_DIR=~/.northradar-bot/whatsapp-session
